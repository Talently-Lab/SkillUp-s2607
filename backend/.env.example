NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://skillup-campus:skillup-campus@localhost:5434/skillup-campus

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGIN=http://localhost:5173
# Proxies in front of the API: 0 locally, usually 1 behind a load balancer
TRUST_PROXY=0

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Swagger UI at /docs. Defaults to true outside production
DOCS_ENABLED=true

# Only used by `pnpm db:seed:admin`
SEED_ADMIN_EMAIL=admin@skillup.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin SkillUp

# Only used by `pnpm db:seed:teacher` (development)
SEED_TEACHER_EMAIL=lucia.fernandez@skillup.edu
SEED_TEACHER_PASSWORD=
SEED_TEACHER_NAME=Lucía Fernández
