### SkillUp Campus API - quick manual tests
# Needs the VS Code extension "REST Client" (humao.rest-client).
# Click "Send Request" above each request. Run login/register first: the
# access token is read from their response, and the refresh cookie is
# remembered by the extension for /refresh and /logout.
# The admin credentials are read from backend/.env (SEED_ADMIN_*).

@baseUrl = http://localhost:3000
@api = {{baseUrl}}/api/v1
@studentEmail = estudiante.demo@gmail.com
@studentPassword = skillup123

### Health check
GET {{baseUrl}}/health

### Register a student (returns 409 EMAIL_TAKEN the second time)
# @name register
POST {{api}}/auth/register
Content-Type: application/json

{
  "fullName": "Estudiante Demo",
  "email": "{{studentEmail}}",
  "password": "{{studentPassword}}"
}

### Login as the student
# @name loginStudent
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "{{studentEmail}}",
  "password": "{{studentPassword}}"
}

### Current user (student)
GET {{api}}/auth/me
Authorization: Bearer {{loginStudent.response.body.accessToken}}

### Login as the admin (create it first with `pnpm db:seed:admin`)
# @name loginAdmin
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "{{$dotenv SEED_ADMIN_EMAIL}}",
  "password": "{{$dotenv SEED_ADMIN_PASSWORD}}"
}

### Current user (admin)
GET {{api}}/auth/me
Authorization: Bearer {{loginAdmin.response.body.accessToken}}

### Refresh the session with the cookie of the last login
# @name refresh
POST {{api}}/auth/refresh

### Current user with the refreshed token
GET {{api}}/auth/me
Authorization: Bearer {{refresh.response.body.accessToken}}

### Logout (revokes the refresh token and clears the cookie)
POST {{api}}/auth/logout

### Refresh after logout -> 401 INVALID_SESSION
POST {{api}}/auth/refresh


### ---------- Error cases ----------

### Wrong password -> 401 INVALID_CREDENTIALS (6 in a row -> 429)
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "{{studentEmail}}",
  "password": "wrong-password"
}

### Invalid body -> 400 VALIDATION_ERROR with details per field
POST {{api}}/auth/register
Content-Type: application/json

{
  "fullName": "A",
  "email": "not-an-email",
  "password": "123"
}

### Malformed JSON -> 400 INVALID_JSON
POST {{api}}/auth/login
Content-Type: application/json

{ "email":

### No token -> 401 UNAUTHORIZED
GET {{api}}/auth/me

### Invalid token -> 401 INVALID_TOKEN
GET {{api}}/auth/me
Authorization: Bearer not-a-real-token


### ---------- Courses (public catalog) ----------

### List published courses (no auth required)
GET {{api}}/courses

### List with filters
GET {{api}}/courses?featured=true&page=1&limit=5

### Get course by id (replace with a real id after creating one)
# GET {{api}}/courses/{{courseId}}

### Invalid uuid -> 400 VALIDATION_ERROR
GET {{api}}/courses/not-a-uuid


### ---------- Admin — Courses ----------

### Create a course (admin only)
# @name createCourse
POST {{api}}/admin/courses
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.accessToken}}

{
  "title": "Introducción a Python",
  "slug": "intro-python",
  "categoryId": 1,
  "level": "beginner",
  "priceCents": 0,
  "status": "published"
}

### Update a course (replace the id)
# PUT {{api}}/admin/courses/{{createCourse.response.body.course.id}}
# Content-Type: application/json
# Authorization: Bearer {{loginAdmin.response.body.accessToken}}
#
# {
#   "featured": true,
#   "priceCents": 1990
# }

### Delete a course (replace the id)
# DELETE {{api}}/admin/courses/{{createCourse.response.body.course.id}}
# Authorization: Bearer {{loginAdmin.response.body.accessToken}}

### No token -> 401 UNAUTHORIZED
POST {{api}}/admin/courses
Content-Type: application/json

{ "title": "Test" }

### Student token -> 403 FORBIDDEN
# POST {{api}}/admin/courses
# Content-Type: application/json
# Authorization: Bearer {{loginStudent.response.body.accessToken}}
#
# { "title": "Test", "slug": "test", "categoryId": 1 }

### ---------- Modules (public) ----------

### List modules for a course (replace courseId)
# @name listModules
GET {{api}}/courses/{{createCourse.response.body.course.id}}/modules

### ---------- Admin — Modules ----------

### Create a module (admin only)
# @name createModule
POST {{api}}/courses/{{createCourse.response.body.course.id}}/modules
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.accessToken}}

{
  "title": "Introducción",
  "position": 1
}

### Update a module
# PUT {{api}}/courses/{{createCourse.response.body.course.id}}/modules/{{createModule.response.body.module.id}}
# Content-Type: application/json
# Authorization: Bearer {{loginAdmin.response.body.accessToken}}
#
# {
#   "title": "Introducción actualizada"
# }

### Delete a module
# DELETE {{api}}/courses/{{createCourse.response.body.course.id}}/modules/{{createModule.response.body.module.id}}
# Authorization: Bearer {{loginAdmin.response.body.accessToken}}

### ---------- Admin — Lessons ----------

### Create a lesson inside a module
# @name createLesson
POST {{api}}/courses/{{createCourse.response.body.course.id}}/modules/{{createModule.response.body.module.id}}/lessons
Content-Type: application/json
Authorization: Bearer {{loginAdmin.response.body.accessToken}}

{
  "title": "Clase 1: Variables",
  "position": 1
}

### Create second lesson
# POST {{api}}/courses/{{createCourse.response.body.course.id}}/modules/{{createModule.response.body.module.id}}/lessons
# Content-Type: application/json
# Authorization: Bearer {{loginAdmin.response.body.accessToken}}
#
# {
#   "title": "Clase 2: Funciones",
#   "position": 2
# }

### ---------- Student — Progress ----------

### Get enrollment id first
# @name myEnrollments
GET {{api}}/enrollments/me
Authorization: Bearer {{loginStudent.response.body.accessToken}}

### Get progress for an enrollment
GET {{api}}/enrollments/{{myEnrollments.response.body.enrollments[0].id}}/progress
Authorization: Bearer {{loginStudent.response.body.accessToken}}

### Complete a lesson
POST {{api}}/enrollments/{{myEnrollments.response.body.enrollments[0].id}}/progress/lessons/{{createLesson.response.body.lesson.id}}/complete
Authorization: Bearer {{loginStudent.response.body.accessToken}}

### Try to complete same lesson again -> 409 ALREADY_COMPLETED
POST {{api}}/enrollments/{{myEnrollments.response.body.enrollments[0].id}}/progress/lessons/{{createLesson.response.body.lesson.id}}/complete
Authorization: Bearer {{loginStudent.response.body.accessToken}}
